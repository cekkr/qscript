// Positive-sign QFT: U[j,k] = exp(2*PI*i*j*k/8)/sqrt(8).
// Register labels print |q2 q1 q0>; start from the most significant wire.
let q = Register(3);
q.Superpose(targets: 2);
q.Phase(angle: PI/2, where: q[2] == 1 && q[1] == 1);
q.Phase(angle: PI/4, where: q[2] == 1 && q[0] == 1);
q.Superpose(targets: 1);
q.Phase(angle: PI/2, where: q[1] == 1 && q[0] == 1);
q.Superpose(targets: 0);
q.Gate(name: SWAP, targets: [0, 2]);
